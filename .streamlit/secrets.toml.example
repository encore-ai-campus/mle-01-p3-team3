# Streamlit Community Cloud > App settings > Secrets 에 아래 내용을 값만 채워 붙여 넣는다.
# 맨 위(섹션 밖)에 둔 키는 Cloud 가 환경 변수로도 넣어 주므로 app/core/config.py 의 Settings 가 그대로 읽는다.
# 이 파일을 secrets.toml 로 복사해 로컬에서 쓸 때는 절대 커밋하지 않는다(.gitignore 에 있음).

OPENAI_API_KEY = "sk-..."
OPENAI_CHAT_MODEL = ""          # 비워 두면 config.py 기본값
TYPESAFE_API_KEY = "..."
TYPESAFE_MODEL = ""             # 비워 두면 config.py 기본값

NEO4J_URI = "neo4j+s://<instance-id>.databases.neo4j.io"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = "..."
NEO4J_DATABASE = "neo4j"

# 선택: 검색 방식 분류기(jev 또는 llm). 비워 두면 jev
SEARCH_ROUTER_BACKEND = "jev"
